# Server
PORT=8080
NODE_ENV=development

# Database
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# JWT
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=24h

# OTP
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=3

# Pinnacle SMS (smsjust.com)
PINNACLE_USERNAME=your_pinnacle_username
PINNACLE_PASSWORD=your_pinnacle_password
PINNACLE_SENDER_ID=your_sender_id
PINNACLE_TEMPLATE_ID=your_template_id
PINNACLE_API_URL=http://www.smsjust.com/sms/user/urlsms.php

# Email OTP (SMTP)
SMTP_HOST=your_smtp_host
SMTP_PORT=465
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
